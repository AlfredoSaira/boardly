server {
    listen 8080;
    root /usr/share/nginx/html;

    # Same-origin API: the browser calls /api/*, nginx forwards to the backend
    # with the prefix stripped, so no CORS is needed in Docker or Kubernetes.
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /healthz {
        access_log off;
        return 200 'ok';
    }

    location / {
        try_files $uri /index.html;
    }
}
